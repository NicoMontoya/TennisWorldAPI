# Copy this file to .dev.vars (never commit .dev.vars)
# Used by wrangler dev for local secrets. Production uses `wrangler secret put`.

# MatchStat / RapidAPI — Scores live + Core (fixtures, rankings, draws)
RAPIDAPI_KEY=your-rapidapi-key-here

# api-tennis.com — leftover routes only (fixtures/tournaments/H2H). Not Scores live.
TENNIS_API_KEY=your-api-tennis-com-key-here

# Set to "true" to run leftover api-tennis routes without that key (mock data)
DEMO_MODE=false

# Protects POST /api/admin/import-* (Sackmann backfills). Production: wrangler secret put ADMIN_SECRET
ADMIN_SECRET=change-me-local-admin-secret

# Optional. Backfill scripts also accept --worker or WORKER_URL (default http://127.0.0.1:8787).
# WORKER_URL=https://tennisworld-api.nicomontoya.workers.dev
